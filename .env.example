# Optional: where RSVP submissions are forwarded (JSON POST).
# Works with Google Apps Script web apps, Zapier/Make catch hooks, Formspree, etc.
RSVP_WEBHOOK_URL=

# Optional: the site's canonical address, if it differs from the live domain
# (https://www.sanzi27.uk). Used for metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Optional: set to 1 to keep a deployment out of search engines entirely
# (robots.txt disallows everything and every page is noindex). Use on previews.
NEXT_PUBLIC_NOINDEX=

# Lets the photo gallery read everyone's photos (Cloudinary → Settings → API
# Keys). Server-side only: they are never sent to the browser. Without them the
# site falls back to Cloudinary's public tag listing, which is restricted by
# default.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
